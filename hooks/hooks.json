{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/body-cap.py\"",
            "if": "Bash(git *)",
            "timeout": 5,
            "statusMessage": "Checking commit message"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/body-cap.py\"",
            "if": "Bash(gh *)",
            "timeout": 5,
            "statusMessage": "Checking PR description"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/body-cap.py\"",
            "if": "Bash(glab *)",
            "timeout": 5,
            "statusMessage": "Checking MR description"
          }
        ]
      }
    ]
  }
}
